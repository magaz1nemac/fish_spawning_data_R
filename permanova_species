library(vegan)

#====================================================
# 1. Read data
#====================================================

dat <- read.csv("species_raw.csv", check.names = FALSE)

#====================================================
# 2. Metadata + species matrix
#====================================================

meta <- dat[, 1:16]

comm <- dat[, 17:ncol(dat)]

# remove species absent from all samples
comm <- comm[, colSums(comm) > 0]

# relative abundance
comm.rel <- decostand(comm, method = "total")

#====================================================
# 3. LOCATION (all 3 locations)
#====================================================

set.seed(123)

adonis_location <- adonis2(
  comm.rel ~ Location,
  data = meta,
  method = "bray",
  permutations = 999
)

adonis_location

#====================================================
# 4. Environmental dataset
#    Chumphon + Chanthaburi only
#====================================================

idx <- meta$Location %in% c("Chumphon", "Chanthaburi")

meta.env <- meta[idx, ]

comm.env <- comm.rel[idx, ]

#====================================================
# 5. LOCATION + MONTH
#====================================================

adonis_month <- adonis2(
  comm.env ~ Location + Month,
  data = meta.env,
  method = "bray",
  permutations = 999
)

adonis_month

#====================================================
# 6. LOCATION + SST
#====================================================

adonis_sst <- adonis2(
  comm.env ~ Location + SST,
  data = meta.env,
  method = "bray",
  permutations = 999
)

adonis_sst

#====================================================
# 7. LOCATION + SALINITY
#====================================================

adonis_sal <- adonis2(
  comm.env ~ Location + Salinity,
  data = meta.env,
  method = "bray",
  permutations = 999
)

adonis_sal

#====================================================
# 8. LOCATION + RAINFALL
#====================================================

adonis_rain <- adonis2(
  comm.env ~ Location + Rainfall,
  data = meta.env,
  method = "bray",
  permutations = 999
)

adonis_rain

#====================================================
# 9. Summary table
#====================================================

results <- data.frame(
  Model = c(
    "Location",
    "Location + Month",
    "Location + SST",
    "Location + Salinity",
    "Location + Rainfall"
  ),
  Pvalue = c(
    adonis_location$`Pr(>F)`[1],
    adonis_month$`Pr(>F)`[1],
    adonis_sst$`Pr(>F)`[1],
    adonis_sal$`Pr(>F)`[1],
    adonis_rain$`Pr(>F)`[1]
  )
)

results
